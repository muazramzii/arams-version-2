# ARAMS 1.0 mail settings: PLACEHOLDERS ONLY.
#
# These are ENVIRONMENT variables for the web server. The application does not
# read this file; it exists to name the variables. Never put real values in the
# repository, in the web root, or in a file next to the code.
#
# Apache (httpd.conf or a virtual host, outside the document root), e.g.:
#   SetEnv ARAMS_MAIL_USERNAME  your-sender@example.com
#   SetEnv ARAMS_MAIL_PASSWORD  <the app password, set on the server only>
# Restart Apache afterwards. If USERNAME or PASSWORD is missing, mail is treated
# as not configured and nothing is sent.
#
# Procedure and status: docs/security/mail-credential-rotation.md

ARAMS_MAIL_USERNAME=your-sender@example.com
ARAMS_MAIL_PASSWORD=
ARAMS_MAIL_HOST=smtp.gmail.com
ARAMS_MAIL_PORT=587
ARAMS_MAIL_SECURE=tls
ARAMS_MAIL_FROM=
ARAMS_MAIL_FROM_NAME=ARAMS UTHM

# Leave 0. Set to 1 only on a local XAMPP whose Gmail TLS certificate cannot be
# verified; it switches certificate verification off.
ARAMS_MAIL_ALLOW_INSECURE=0
